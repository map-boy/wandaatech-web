# Copy to .env.local and fill in. See SETUP.md for what each one does.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (/admin) ──────────────────────────────────────────────────
ADMIN_PASSWORD=
# Signs the admin session cookie. Falls back to ADMIN_PASSWORD if unset.
ADMIN_SESSION_SECRET=

# ── Google ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6727162627172885
NEXT_PUBLIC_GA_ID=G-RE59R799HT
# Set to true to suppress all ads in a production deployment (e.g. staging).
NEXT_PUBLIC_ADS_DISABLED=

# Optional: ad slot IDs, if you would rather not manage them in /admin.
NEXT_PUBLIC_AD_SLOT_HOME_TOP=
NEXT_PUBLIC_AD_SLOT_HOME_MID=
NEXT_PUBLIC_AD_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_AD_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_AD_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_AD_SLOT_LIST_GRID=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
